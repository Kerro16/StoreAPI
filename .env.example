# Copy to .env (never commit it) and load the values as environment variables.
DB_URL=jdbc:postgresql://localhost:5432/Product
DB_USERNAME=postgres
DB_PASSWORD=change-me
# Base64 string of at least 32 random bytes, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-base64-string
JWT_EXPIRATION_MS=86400000
# Set to true behind HTTPS
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:4200
DDL_AUTO=update
SHOW_SQL=false
